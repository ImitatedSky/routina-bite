<?xml version="1.0" encoding="utf-8"?>
<!--
  喝水 1×1：一個水的圓環，中間是「+250」，下面一行小字是今天喝了多少。
  整塊就是一顆按鈕（點了直接記一杯），底色用水的淡色，和另外兩塊分得開。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bite_water_widget_background"
    android:padding="6dp">

    <ImageView
        android:id="@+id/water_widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/water_widget_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/water_widget_add"
            android:textColor="@color/widget_water"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/water_widget_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
