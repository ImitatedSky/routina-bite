<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 啟動圖示的底色，取自圖示本身的奶油色，前景疊上去才不會有接縫 -->
    <color name="ic_launcher_background">#FBF4E2</color>

    <!--
      桌面小工具的顏色。RemoteViews 由桌面那支 App 畫，解不到 Bite 的 Compose 主題，
      所以在這裡定義一組具名顏色，深色版本放 values-night/colors.xml，由桌面的設定決定用哪一組。
    -->
    <color name="widget_background">#FBF4E2</color>
    <color name="widget_text">#2B2823</color>
    <color name="widget_text_dim">#6E675A</color>
    <!-- 熱量用啟動圖示上那團火焰的珊瑚色：小工具就擺在圖示旁邊，兩者同色才像一家人 -->
    <color name="widget_kcal">#B95A46</color>
    <!-- 喝水：低飽和的偏青藍 -->
    <color name="widget_water">#3F7FA3</color>
    <!-- 膠囊按鈕與喝水小工具的底：主色的淡版 -->
    <color name="widget_kcal_container">#F7E1D6</color>
    <color name="widget_water_container">#DCEBF2</color>

    <!--
      圓環的顏色（WidgetRings.kt 畫成 Bitmap）。Bitmap 在畫的當下就定色，之後切深色模式不會重畫，
      所以這幾個刻意不在 values-night 覆寫，選的是在奶油底與深色底上都看得清楚的中間值。
    -->
    <color name="widget_ring_kcal">#E07B67</color>
    <color name="widget_ring_kcal_over">#C8503A</color>
    <color name="widget_ring_water">#5A9CC2</color>
    <color name="widget_ring_track">#A89A80</color>
    <color name="widget_ring_protein">#5E9E8C</color>
    <color name="widget_ring_fat">#D69A63</color>
    <color name="widget_ring_carbs">#9A8AC8</color>

    <!-- 三大營養素，與 App 內的 MacroColors 同值 -->
    <color name="widget_macro_protein">#4E8A7B</color>
    <color name="widget_macro_fat">#C2895A</color>
    <color name="widget_macro_carbs">#8A7BB5</color>
</resources>
