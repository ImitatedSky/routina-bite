<?xml version="1.0" encoding="utf-8"?>
<!--
  預設 4×2（targetCell），但可以一路縮到 1×1：三種尺寸各有一個版面，
  由 provider 依桌面回報的 OPTION_APPWIDGET_MIN_WIDTH/HEIGHT 決定用哪一個（D77）。
  minWidth/minHeight 是縮放下限，40dp 就是桌面一格（70n − 30，n=1）。
  updatePeriodMillis 是保險用的（系統實際最短 30 分鐘）：真正的即時更新由
  BiteApp 觀察資料流觸發，跨日由 receiver 的 DATE_CHANGED 觸發。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/bite_widget"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="40dp"
    android:previewLayout="@layout/bite_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
